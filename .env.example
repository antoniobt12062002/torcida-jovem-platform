# Exemplo para desenvolvimento local. Copie para `.env` (ignorado pelo git).
# O repositório é público: nunca coloque segredos reais neste arquivo.
# As credenciais abaixo são as do banco local de docker-compose.yml.

# Ambiente: development, staging ou production. Ausente vale production.
APP_ENV=development
# Nível de log: debug, info, warn ou error.
LOG_LEVEL=info
PORT=8080

# Conexão da API, com o papel de aplicação (sem DDL).
DATABASE_URL=postgres://tj_app:tj_app_dev@localhost:5432/tj?sslmode=disable
# Conexão do dono do banco, usada só para migrações (ferramenta migrate).
MIGRATE_DATABASE_URL=postgres://tj_owner:tj_owner_dev@localhost:5432/tj?sslmode=disable

# Origens do navegador autorizadas, separadas por vírgula (esquema://host[:porta], sem caminho).
# Vazio bloqueia toda origem, exceto em development, onde o padrão é http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000

# Cookie de sessão. COOKIE_SECURE=false só é aceito com APP_ENV=development.
COOKIE_SECURE=false
# Domínio do cookie (opcional). A configuração final depende da estratégia de hospedagem.
COOKIE_DOMAIN=
# Sessão: minutos sem uso e horas de teto absoluto (padrões: 60 e 8).
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=8

# Front (Next.js): endereço da API, lido no servidor.
API_URL=http://localhost:8080
