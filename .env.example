# Exemplo para desenvolvimento local. Copie para `.env` (ignorado pelo git).
# O repositório é público: nunca coloque segredos reais neste arquivo.
# As credenciais abaixo são as do banco local de docker-compose.yml.

# Ambiente: development, staging ou production. Ausente vale production.
APP_ENV=development
# Nível de log: debug, info, warn ou error.
LOG_LEVEL=info
PORT=8080

# Conexão da API, com o papel de aplicação (sem DDL).
DATABASE_URL=postgres://tj_app:tj_app_dev@localhost:5432/tj?sslmode=disable
# Conexão do dono do banco, usada só para migrações (ferramenta migrate).
MIGRATE_DATABASE_URL=postgres://tj_owner:tj_owner_dev@localhost:5432/tj?sslmode=disable

# Origens do navegador autorizadas, separadas por vírgula (esquema://host[:porta], sem caminho).
# Vazio bloqueia toda origem, exceto em development, onde o padrão é http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000

# Cookie de sessão. COOKIE_SECURE=false só é aceito com APP_ENV=development.
COOKIE_SECURE=false
# Domínio do cookie (opcional). A configuração final depende da estratégia de hospedagem.
COOKIE_DOMAIN=
# Sessão: minutos sem uso e horas de teto absoluto (padrões: 60 e 8).
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=8

# Chave do HMAC-SHA256 dos e-mails em tentativas de login e auditoria. Mínimo 32 bytes.
# Obrigatória fora de development (em development, ausente usa uma chave só de desenvolvimento).
# Gere com: openssl rand -base64 48
AUTH_HASH_KEY=
# Parâmetros do argon2id (padrões: 19456 KiB, 2 iterações, paralelismo 1) e validade
# do token de recuperação de senha, em minutos (padrão 30).
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
PASSWORD_RESET_TTL_MINUTES=30

# E-mail: log (só registra domínio do destinatário e assunto) ou disabled (não envia).
# Um provedor real será acrescentado depois, atrás da mesma interface.
EMAIL_PROVIDER=log
EMAIL_FROM=TJ Platform <no-reply@localhost>
# Base dos links enviados por e-mail (https fora de development).
APP_BASE_URL=http://localhost:3000

# Front (Next.js): endereço da API, lido no servidor.
API_URL=http://localhost:8080

# Documentos: object storage compatível com S3 (ADR-006). Nada na API consome
# ainda, então fica desligado por padrão; as cinco variáveis S3_* só são
# exigidas com STORAGE_ENABLED=true. S3_USE_PATH_STYLE=true é exigido por
# emuladores locais. Provedor de produção ainda não definido.
STORAGE_ENABLED=false
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=false
# Validade da URL assinada de acesso a um documento, em segundos (padrão 300).
DOCUMENT_URL_TTL_SECONDS=300
